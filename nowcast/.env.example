# Copy to .env (gitignored). Same names as gdpnow-replication; in GitHub workflows they are repository secrets.
BLS_CONTACT=        # required for BLS downloads (User-Agent contact string)
FRED_API_KEY=       # ALFRED vintages (stage 03 onward)
BEA_API_KEY=        # only if a BEA table is not in the bulk files (01a needs none)
